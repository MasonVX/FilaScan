import { ReaderState } from "app.slint";

export { ReaderState }

component IdleView inherits Rectangle {
    background: #10151d;

    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        alignment: center;

        Text {
            horizontal-alignment: center;
            color: #72d6ff;
            font-size: 34px;
            font-weight: 700;
            text: "FilaScan";
        }

        Rectangle {
            height: 5px;
            background: ReaderState.reader-available ? #2ecc71 : #e74c3c;
        }

        Text {
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            color: white;
            font-size: 24px;
            text: ReaderState.status-text;
        }

        if ReaderState.wifi-setup-active: Rectangle {
            height: 82px;
            background: #1d2733;
            border-radius: 8px;

            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                Text { color: #a9b8c7; font-size: 13px; text: "Wi-Fi setup"; }
                Text { color: white; font-size: 15px; text: ReaderState.wifi-url; }
                Text { color: white; font-size: 15px; text: "SSID: " + ReaderState.wifi-ssid + "   Key: " + ReaderState.wifi-key; }
            }
        }
    }
}

component SpoolView inherits Rectangle {
    background: #10151d;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        HorizontalLayout {
            height: 230px;
            spacing: 12px;

            Rectangle {
                width: 158px;
                background: ReaderState.primary-color;
                border-width: 2px;
                border-color: #d7e2ec;
                border-radius: 10px;

                if ReaderState.has-secondary-color: Rectangle {
                    y: parent.height / 2;
                    height: parent.height / 2;
                    background: ReaderState.secondary-color;
                    border-radius: 8px;
                }

                Rectangle {
                    x: 8px;
                    y: parent.height - 34px;
                    width: parent.width - 16px;
                    height: 26px;
                    background: #dd10151d;
                    border-radius: 5px;
                    Text {
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: white;
                        font-size: 13px;
                        text: ReaderState.color-code;
                    }
                }
            }

            VerticalLayout {
                spacing: 3px;

                Text {
                    color: #72d6ff;
                    font-size: 27px;
                    font-weight: 700;
                    overflow: elide;
                    text: ReaderState.material-name;
                }
                Text { color: #a9b8c7; font-size: 14px; overflow: elide; text: ReaderState.material-detail; }
                Text { color: white; font-size: 23px; font-weight: 600; overflow: elide; text: ReaderState.color-name; }
                Text {
                    color: #a9b8c7;
                    font-size: 14px;
                    text: ReaderState.bambu-color-code == "" ? "Bambu color code unavailable" : "Bambu color " + ReaderState.bambu-color-code;
                }

                Rectangle { height: 1px; background: #344250; }
                Text { color: white; font-size: 15px; text: ReaderState.physical-parameters; }
                Text { color: white; font-size: 15px; text: ReaderState.temperature-parameters; }
                Text { color: white; font-size: 15px; text: ReaderState.drying-parameters; }
                Text { color: #a9b8c7; font-size: 13px; overflow: elide; text: ReaderState.production-parameters; }
            }
        }

        Rectangle { height: 1px; background: #344250; }
        Text {
            color: #8797a8;
            font-size: 12px;
            overflow: elide;
            text: ReaderState.identifier-parameters;
        }
        Text {
            horizontal-alignment: center;
            color: ReaderState.reading ? #f4c542 : #72d6ff;
            font-size: 14px;
            text: ReaderState.reading ? "Reading tag…" : "Ready for the next Bambu spool";
        }
    }
}

export component AppWindow inherits Window {
    width: 480px;
    height: 320px;

    if ReaderState.has-spool: SpoolView { }
    if !ReaderState.has-spool: IdleView { }
}
